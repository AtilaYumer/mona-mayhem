---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap"
			rel="stylesheet"
		/>
		<title>Mona Mayhem - GitHub Contribution Battle Arena</title>
		<style>
			:root {
				font-family: "Press Start 2P", "Courier New", monospace;
				color-scheme: dark;
				--bg: #0a0a1a;
				--bg-panel: #111327;
				--bg-panel-soft: #0f1122;
				--text: #eff3ff;
				--text-soft: #c6cdea;
				--accent-green: #5fed83;
				--accent-purple: #8a2be2;
				--border-neon: rgba(95, 237, 131, 0.35);
				--shadow-green: 0 0 10px rgba(95, 237, 131, 0.65);
				--shadow-purple: 0 0 14px rgba(138, 43, 226, 0.65);
				--pulse-fast: 1.8s;
				--pulse-medium: 2.6s;
				--pulse-slow: 4.2s;
			}

			* {
				box-sizing: border-box;
			}

			body {
				margin: 0;
				min-height: 100vh;
				background: radial-gradient(circle at 20% 10%, #15163a 0%, var(--bg) 42%, #050510 100%);
				color: var(--text);
				position: relative;
				overflow-x: hidden;
			}

			body::before {
				content: "";
				position: fixed;
				inset: 0;
				background:
					repeating-linear-gradient(
						to bottom,
						rgba(255, 255, 255, 0.035) 0,
						rgba(255, 255, 255, 0.035) 1px,
						transparent 1px,
						transparent 3px
					),
					linear-gradient(120deg, rgba(95, 237, 131, 0.05), rgba(138, 43, 226, 0.04));
				pointer-events: none;
				opacity: 0.03;
				z-index: 0;
			}

			body::after {
				content: "";
				position: fixed;
				inset: 0;
				background: radial-gradient(circle at center, transparent 48%, rgba(0, 0, 0, 0.55) 100%);
				pointer-events: none;
				z-index: 0;
			}

			main {
				max-width: 960px;
				margin: 0 auto;
				padding: 2rem 1rem 3rem;
				position: relative;
				z-index: 1;
			}

			h1 {
				margin: 0 0 0.75rem;
				font-size: clamp(1.2rem, 2vw, 1.8rem);
				line-height: 1.45;
				color: var(--accent-green);
				text-shadow:
					0 0 6px rgba(95, 237, 131, 0.9),
					0 0 14px rgba(95, 237, 131, 0.7),
					0 0 24px rgba(138, 43, 226, 0.45);
				animation:
					neonPulse var(--pulse-medium) ease-in-out infinite,
					electricalFlicker 6.5s steps(1, end) infinite;
			}

			p {
				line-height: 1.6;
				color: var(--text-soft);
			}

			.battle-form {
				display: grid;
				grid-template-columns: 1fr;
				gap: 0.75rem;
				margin-top: 1.5rem;
				padding: 1rem;
				border: 1px solid var(--border-neon);
				border-radius: 10px;
				background: linear-gradient(160deg, rgba(95, 237, 131, 0.05), rgba(138, 43, 226, 0.08)) var(--bg-panel);
				box-shadow: var(--shadow-green), inset 0 0 20px rgba(138, 43, 226, 0.14);
			}

			.battle-form > div,
			.battle-form > button {
				opacity: 0;
				transform: translateY(10px);
				animation: floatIn 700ms ease forwards;
			}

			.battle-form > div:nth-child(1) {
				animation-delay: 100ms;
			}

			.battle-form > div:nth-child(2) {
				animation-delay: 220ms;
			}

			.battle-form > button {
				animation-delay: 340ms;
			}

			label {
				font-size: 0.7rem;
				color: var(--text-soft);
			}

			input {
				width: 100%;
				padding: 0.7rem;
				border-radius: 8px;
				border: 1px solid rgba(138, 43, 226, 0.5);
				background: var(--bg-panel-soft);
				color: var(--text);
				box-shadow: inset 0 0 0 1px rgba(95, 237, 131, 0.12);
				transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
			}

			input:focus-visible {
				outline: none;
				border-color: var(--accent-green);
				box-shadow:
					0 0 0 2px rgba(95, 237, 131, 0.2),
					0 0 18px rgba(138, 43, 226, 0.38);
				transform: translateY(-1px);
			}

			button {
				padding: 0.8rem 1rem;
				border: 0;
				border-radius: 8px;
				background: linear-gradient(120deg, var(--accent-green), #49cc95);
				color: #08110b;
				font-weight: 700;
				cursor: pointer;
				box-shadow: 0 0 18px rgba(95, 237, 131, 0.45);
				transition: transform 180ms ease, box-shadow 180ms ease;
			}

			button:hover:not(:disabled) {
				transform: translateY(-1px);
				box-shadow:
					0 0 22px rgba(95, 237, 131, 0.75),
					0 0 10px rgba(138, 43, 226, 0.45);
			}

			button:disabled {
				opacity: 0.6;
				cursor: not-allowed;
			}

			.status {
				min-height: 1.5rem;
				font-size: 0.8rem;
				margin-top: 0.75rem;
			}

			.status.error {
				color: #ff8f8f;
				text-shadow: 0 0 10px rgba(255, 143, 143, 0.5);
			}

			.status.loading {
				color: var(--accent-green);
				text-shadow:
					0 0 10px rgba(95, 237, 131, 0.7),
					0 0 16px rgba(138, 43, 226, 0.45);
				animation: loadingShift var(--pulse-fast) linear infinite;
			}

			.results {
				margin-top: 1.25rem;
				padding: 1rem;
				border: 1px solid rgba(138, 43, 226, 0.4);
				border-radius: 10px;
				background: linear-gradient(180deg, rgba(138, 43, 226, 0.1), rgba(95, 237, 131, 0.05)) var(--bg-panel);
				box-shadow:
					0 0 18px rgba(138, 43, 226, 0.3),
					inset 0 0 18px rgba(95, 237, 131, 0.08);
			}

			:global(.result-grid) {
				display: grid;
				grid-template-columns: 1fr;
				gap: 0.75rem;
			}

			:global(.player-card) {
				padding: 0.9rem;
				border: 1px solid rgba(95, 237, 131, 0.36);
				border-radius: 8px;
				background: linear-gradient(160deg, rgba(138, 43, 226, 0.12), rgba(95, 237, 131, 0.06)) #0d1022;
				position: relative;
				overflow: hidden;
				box-shadow:
					0 0 16px rgba(95, 237, 131, 0.2),
					inset 0 0 20px rgba(138, 43, 226, 0.18);
			}

			:global(.player-card)::before {
				content: "";
				position: absolute;
				top: -120%;
				left: -40%;
				width: 45%;
				height: 320%;
				background: linear-gradient(
					110deg,
					rgba(255, 255, 255, 0) 0%,
					rgba(255, 255, 255, 0.08) 45%,
					rgba(255, 255, 255, 0.28) 52%,
					rgba(255, 255, 255, 0.08) 58%,
					rgba(255, 255, 255, 0) 100%
				);
				transform: rotate(14deg);
				animation: cardShimmer 4.2s linear infinite;
				pointer-events: none;
			}

			:global(.vs-badge) {
				display: grid;
				place-items: center;
				font-size: 0.85rem;
				padding: 0.5rem 0;
				color: transparent;
				background: linear-gradient(90deg, var(--accent-green), var(--accent-purple), var(--accent-green));
				background-size: 240% 100%;
				-webkit-background-clip: text;
				background-clip: text;
				text-shadow:
					0 0 8px rgba(95, 237, 131, 0.45),
					0 0 12px rgba(138, 43, 226, 0.45);
				animation:
					gradientShift var(--pulse-slow) linear infinite,
					vsPulse 1.6s ease-in-out infinite;
				transform-origin: center;
			}

			:global(.player-card h2) {
				font-size: 0.85rem;
				margin: 0 0 0.75rem;
			}

			:global(.player-card dl) {
				margin: 0;
				display: grid;
				gap: 0.4rem;
			}

			:global(.player-card dt) {
				font-size: 0.65rem;
				color: var(--text-soft);
			}

			:global(.player-card dd) {
				margin: 0;
				font-size: 0.85rem;
			}

			:global(.graph-title) {
				margin: 0.85rem 0 0.45rem;
				font-size: 0.65rem;
				color: var(--accent-green);
				text-shadow: 0 0 8px rgba(95, 237, 131, 0.5);
			}

			:global(.contrib-grid-wrap) {
				margin-top: 0;
				overflow-x: auto;
				padding-bottom: 0.25rem;
			}

			:global(.contrib-grid) {
				display: grid;
				grid-auto-flow: column;
				grid-auto-columns: 12px;
				grid-template-rows: repeat(7, 12px);
				gap: 2px;
				align-items: center;
			}

			:global(.gh-graph) {
				margin-top: 0.8rem;
			}

			:global(.months-row) {
				display: grid;
				grid-template-columns: repeat(var(--week-count), 12px);
				gap: 2px;
				margin-left: 46px;
				margin-bottom: 0.35rem;
				font-size: 0.65rem;
				color: #c5ccea;
				line-height: 1;
			}

			:global(.month-label) {
				white-space: nowrap;
				color: var(--text-soft);
			}

			:global(.graph-body) {
				display: grid;
				grid-template-columns: 38px 1fr;
				gap: 8px;
				align-items: start;
			}

			:global(.weekday-labels) {
				display: grid;
				grid-template-rows: repeat(7, 12px);
				gap: 2px;
				font-size: 0.65rem;
				color: var(--text-soft);
			}

			:global(.weekday-labels span) {
				line-height: 12px;
			}

			:global(.weekday-labels span:nth-child(1)) {
				grid-row: 2;
			}

			:global(.weekday-labels span:nth-child(2)) {
				grid-row: 4;
			}

			:global(.weekday-labels span:nth-child(3)) {
				grid-row: 6;
			}

			:global(.contrib-cell) {
				width: 12px;
				height: 12px;
				border-radius: 2px;
				outline: 1px solid rgba(255, 255, 255, 0.08);
				transition: transform 140ms ease, box-shadow 140ms ease, filter 140ms ease;
			}

			:global(.contrib-cell:hover) {
				transform: scale(1.18);
				filter: saturate(1.2);
				box-shadow:
					0 0 8px rgba(95, 237, 131, 0.75),
					0 0 12px rgba(138, 43, 226, 0.55);
			}

			:global(.contrib-cell:focus-visible) {
				outline: 2px solid var(--accent-purple);
				box-shadow: 0 0 10px rgba(138, 43, 226, 0.75);
			}

			:global(.legend-row) {
				display: flex;
				justify-content: flex-end;
				align-items: center;
				gap: 0.45rem;
				margin-top: 0.55rem;
				font-size: 0.65rem;
				color: var(--text-soft);
			}

			:global(.legend) {
				display: flex;
				gap: 0.3rem;
				margin-top: 0;
			}

			:global(.legend-swatch) {
				width: 12px;
				height: 12px;
				border-radius: 2px;
				outline: 1px solid rgba(255, 255, 255, 0.1);
			}

			@keyframes neonPulse {
				0%,
				100% {
					text-shadow:
						0 0 6px rgba(95, 237, 131, 0.85),
						0 0 14px rgba(95, 237, 131, 0.65),
						0 0 24px rgba(138, 43, 226, 0.3);
				}

				50% {
					text-shadow:
						0 0 10px rgba(95, 237, 131, 1),
						0 0 20px rgba(95, 237, 131, 0.9),
						0 0 34px rgba(138, 43, 226, 0.65);
				}
			}

			@keyframes gradientShift {
				0% {
					background-position: 0% 50%;
				}

				50% {
					background-position: 100% 50%;
				}

				100% {
					background-position: 0% 50%;
				}
			}

			@keyframes vsPulse {
				0%,
				100% {
					transform: scale(1);
					text-shadow:
						0 0 8px rgba(95, 237, 131, 0.45),
						0 0 12px rgba(138, 43, 226, 0.45);
				}

				50% {
					transform: scale(1.14);
					text-shadow:
						0 0 14px rgba(95, 237, 131, 0.9),
						0 0 22px rgba(138, 43, 226, 0.95),
						0 0 30px rgba(138, 43, 226, 0.55);
				}
			}

			@keyframes cardShimmer {
				0% {
					transform: translateX(-120%) rotate(14deg);
					opacity: 0;
				}

				8% {
					opacity: 1;
				}

				30% {
					transform: translateX(360%) rotate(14deg);
					opacity: 0;
				}

				100% {
					transform: translateX(360%) rotate(14deg);
					opacity: 0;
				}
			}

			@keyframes floatIn {
				0% {
					opacity: 0;
					transform: translateY(10px);
				}

				100% {
					opacity: 1;
					transform: translateY(0);
				}
			}

			@keyframes loadingShift {
				0%,
				100% {
					color: var(--accent-green);
				}

				50% {
					color: var(--accent-purple);
				}
			}

			@keyframes electricalFlicker {
				0%,
				19%,
				21%,
				58%,
				60%,
				100% {
					opacity: 1;
					filter: brightness(1);
				}

				20% {
					opacity: 0.93;
					filter: brightness(0.88);
				}

				59% {
					opacity: 0.95;
					filter: brightness(0.92);
				}

				82% {
					opacity: 0.97;
					filter: brightness(0.96);
				}
			}

			@media (prefers-reduced-motion: reduce) {
				h1,
				.status.loading,
				:global(.vs-badge),
				:global(.player-card)::before,
				.battle-form > div,
				.battle-form > button {
					animation: none !important;
				}

				:global(.contrib-cell),
				button,
				input {
					transition: none !important;
				}
			}

			@media (min-width: 760px) {
				.battle-form {
					grid-template-columns: 1fr 1fr auto;
					align-items: end;
				}
			}

			@media (max-width: 720px) {
				body::before {
					opacity: 0.22;
				}

				h1 {
					font-size: 1.05rem;
					line-height: 1.5;
				}

				:global(.contrib-cell:hover) {
					transform: scale(1.06);
					box-shadow: 0 0 6px rgba(95, 237, 131, 0.55);
				}
			}
		</style>
	</head>
	<body>
		<main>
			<h1>Mona Mayhem - GitHub Contribution Battle Arena</h1>
			<p>Enter two GitHub usernames and start a contribution showdown.</p>

			<form id="battleForm" class="battle-form" novalidate>
				<div>
					<label for="playerOne">Player 1 Username</label>
					<input id="playerOne" name="playerOne" type="text" placeholder="octocat" autocomplete="off" required />
				</div>
				<div>
					<label for="playerTwo">Player 2 Username</label>
					<input id="playerTwo" name="playerTwo" type="text" placeholder="torvalds" autocomplete="off" required />
				</div>
				<button id="battleButton" type="submit">Battle</button>
			</form>

			<p id="status" class="status" aria-live="polite"></p>

			<section class="results" aria-live="polite" aria-label="Battle results">
				<div id="resultsContent">Run a battle to see each player's contribution summary.</div>
			</section>
		</main>

		<script>
			import { initBattlePage } from '../scripts/battle';

			initBattlePage();
		</script>
	</body>
</html>
